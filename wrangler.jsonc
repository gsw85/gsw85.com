{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gsw85",
	"main": ".open-next/worker.js",
    "preview_urls": true,
    "workers_dev": true,
	"compatibility_date": "2025-03-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"r2_buckets": [],
	"observability": {
		"enabled": true
	}
}